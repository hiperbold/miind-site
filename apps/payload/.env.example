# Copie para .env e troque os valores. Nunca versione o .env.
DATABASE_URI=postgres://miind:miind_local_dev@127.0.0.1:5438/miind_bu1lder
# Gere com: openssl rand -hex 32
PAYLOAD_SECRET=troque-por-um-segredo-aleatorio
# Endereço do servidor do Payload (admin e API). Na VPS: o domínio próprio do admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Endereço público das LPs, usado em canonical, og:url e og:image (lido no build).
# Produção: https://www.miind.com.br
PUBLIC_SITE_URL=http://localhost:3010
# Usuário admin criado pelo `pnpm seed` e, em produção, no init do Payload (só se ainda não existir)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# 1 = site inteiro com robots noindex,nofollow e robots.txt bloqueando tudo (homologação).
SITE_NOINDEX=
# Pasta absoluta dos uploads da coleção media. Vazio: apps/payload/media. Na imagem: /app/media.
MEDIA_DIR=
# Webhook do n8n que recebe os cadastros do formulário (fase 3).
N8N_WEBHOOK_URL=
# Opcional: se definido, vai no cabeçalho X-Webhook-Secret de cada envio ao n8n (o fluxo confere).
N8N_WEBHOOK_SECRET=
# Opcional: Cloudflare Turnstile nos formulários. Só ativa com as duas chaves.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: teto de cadastros aceitos por processo a cada 10 minutos (padrão 60).
FORM_LIMITE_GLOBAL=

# Tracking (@hiperbold/payload-tracking 1.3.0). Gere cada chave com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keyring AES-256-GCM (segredos das Tags e snapshots da outbox): JSON {"id": "chave"}
PAYLOAD_TRACKING_ENCRYPTION_KEYS={"k1":"troque"}
PAYLOAD_TRACKING_ACTIVE_KEY_ID=k1
# Keyring HMAC (token do navegador e cookie pt_subject), independente do anterior
PAYLOAD_TRACKING_BROWSER_TOKEN_KEYS={"b1":"troque"}
PAYLOAD_TRACKING_BROWSER_TOKEN_ACTIVE_KEY_ID=b1
# Banco PRÓPRIO do c15t (consentimento), mesma instância do Postgres. O servidor cria se faltar.
C15T_DATABASE_URI=postgres://miind:miind_local_dev@127.0.0.1:5438/miind_bu1lder_c15t
# Opcional: 0 desliga o worker de entregas (verificação de rede local). Padrão: ligado.
TRACKING_WORKER=
# Opcional: IPs exatos dos proxies que gravam o X-Forwarded-For (vírgula). Vazio: o módulo não lê IP.
TRACKING_TRUSTED_PROXIES=
# Opcional: endereço interno do c15t para o servidor consultar o consentimento.
# Padrão: http://127.0.0.1:$PORT/api/c15t (PORT padrão 3010).
C15T_BACKEND_URL=
