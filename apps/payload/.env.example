# Copie para .env e troque os valores. Nunca versione o .env.
DATABASE_URI=postgres://miind:miind_local_dev@127.0.0.1:5438/miind_bu1lder
# Gere com: openssl rand -hex 32
PAYLOAD_SECRET=troque-por-um-segredo-aleatorio
# Endereço do servidor do Payload (admin e API). Na VPS: o domínio próprio do admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Endereço público das LPs, usado em canonical, og:url e og:image (lido no build).
# Produção: https://www.miind.com.br
PUBLIC_SITE_URL=http://localhost:3010
# Usuário admin criado pelo `pnpm seed` (só se ainda não existir)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque-esta-senha
