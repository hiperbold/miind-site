# Copie para .env e troque os valores. Nunca versione o .env.
DATABASE_URI=postgres://miind:miind_local_dev@127.0.0.1:5438/miind_bu1lder
# Gere com: openssl rand -hex 32
PAYLOAD_SECRET=troque-por-um-segredo-aleatorio
# Endereço do servidor do Payload (admin e API). Na VPS: o domínio próprio do admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Endereço público das LPs, usado em canonical, og:url e og:image (lido no build).
# Produção: https://www.miind.com.br
PUBLIC_SITE_URL=http://localhost:3010
# Usuário admin criado pelo `pnpm seed` e, em produção, no init do Payload (só se ainda não existir)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# 1 = site inteiro com robots noindex,nofollow e robots.txt bloqueando tudo (homologação).
SITE_NOINDEX=
# Pasta absoluta dos uploads da coleção media. Vazio: apps/payload/media. Na imagem: /app/media.
MEDIA_DIR=
# Webhook do n8n que recebe os cadastros do formulário (fase 3).
N8N_WEBHOOK_URL=
# Opcional: se definido, vai no cabeçalho X-Webhook-Secret de cada envio ao n8n (o fluxo confere).
N8N_WEBHOOK_SECRET=
# Opcional: Cloudflare Turnstile nos formulários. Só ativa com as duas chaves.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: teto de cadastros aceitos por processo a cada 10 minutos (padrão 60).
FORM_LIMITE_GLOBAL=
